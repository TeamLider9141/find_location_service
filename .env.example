TELEGRAM_BOT_TOKEN=
DATABASE_PATH=data/find_location.sqlite3
# Comma separated Telegram user ids allowed into /admin
ADMIN_IDS=
# Rate limit per driver. Leave empty to use the defaults.
# Messages allowed back to back before throttling kicks in (min 1)
THROTTLE_BURST=5
# How many messages a second a driver earns back (must be above 0)
THROTTLE_REFILL_PER_SECOND=1.0
# Seconds between two "you are too fast" replies. 0 answers every dropped message
THROTTLE_WARNING_SECONDS=10
# Seconds of silence before a driver is dropped from memory (must be above 0)
THROTTLE_IDLE_SECONDS=300
# How often that cleanup sweep runs
THROTTLE_PRUNE_INTERVAL_SECONDS=60
