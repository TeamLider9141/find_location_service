TELEGRAM_BOT_TOKEN=
DATABASE_PATH=data/find_location.sqlite3
# Comma separated Telegram user ids allowed into /admin
ADMIN_IDS=

# =============================================================================
# RATE LIMIT — how fast one driver may write
# =============================================================================
#
# Nothing stopped a single user from sending fifty messages a second. Each one
# is a search plus a SQLite write, so one person could slow the bot down for
# everybody, and Telegram answers a bot that busy with a 429.
#
# The limit is a token bucket, one per driver:
#   - The bucket starts full, holding THROTTLE_BURST tokens.
#   - Every message spends one token.
#   - Tokens come back over time, THROTTLE_REFILL_PER_SECOND of them a second.
#   - With no tokens left the message is dropped before any handler runs, so it
#     never reaches the database. The driver is told once that they are too fast.
#
# A bucket rather than a flat "N per second" because tapping menu buttons four
# or five times in a row is normal use. The bucket absorbs that burst while
# still refusing a sustained stream; a flat limit would refuse both.
#
# The file is read at startup only, so restart the bot after changing anything.
# A value that is unreadable or out of range is ignored and the default used, so
# a typo cannot lock the bot shut.

# QUICK REFERENCE — the detail sits above each variable
#
# ┌─────────────────────────────────┬───────────────────────────────┬───────────────────────┬───────┬─────────┐
# │ Variable                        │ What it does                  │ Raising it            │ Range │ Default │
# ├─────────────────────────────────┼───────────────────────────────┼───────────────────────┼───────┼─────────┤
# │ THROTTLE_BURST                  │ messages allowed back to back │ more permissive       │ >= 1  │ 5       │
# │ THROTTLE_REFILL_PER_SECOND      │ messages earned back a second │ more permissive       │ > 0   │ 1.0     │
# │ THROTTLE_WARNING_SECONDS        │ gap between two warnings      │ fewer warnings        │ >= 0  │ 10      │
# │ THROTTLE_IDLE_SECONDS           │ how long a bucket is kept     │ more memory           │ > 0   │ 300     │
# │ THROTTLE_PRUNE_INTERVAL_SECONDS │ how often eviction runs       │ less CPU, more memory │ >= 0  │ 60      │
# └─────────────────────────────────┴───────────────────────────────┴───────────────────────┴───────┴─────────┘

# Messages a driver may send back to back. Higher is more permissive.
# Minimum 1: zero would drop everyone's messages, including the admin who has to
# undo it.
THROTTLE_BURST=5

# Tokens returned per second — the sustained rate a driver is allowed.
# 1.0 is one message a second, 0.5 is one every two seconds, 2.0 is two a
# second. The bucket never fills past THROTTLE_BURST, so a driver who stayed
# quiet all day comes back with five tokens, not with a day's worth.
# Must be above 0: at zero nothing ever refills and a driver who spent their
# burst is throttled forever.
THROTTLE_REFILL_PER_SECOND=1.0

# Seconds between two "you are too fast" replies. Answering every dropped
# message would turn one flood into two — fifty messages in, fifty replies out —
# so the warning goes out once per window and the rest are dropped silently.
# 0 answers every dropped message; that is a choice, not a typo, and is allowed.
THROTTLE_WARNING_SECONDS=10

# Seconds of silence before a driver's bucket is forgotten. The buckets live in
# memory, one per driver, and without eviction every person who ever wrote stays
# there until the process ends.
# A forgotten driver returns with a full bucket, so keep this well above the
# refill window: at five seconds, someone messaging every six seconds is never
# limited at all. Must be above 0.
THROTTLE_IDLE_SECONDS=300

# How often that eviction sweep runs. The sweep walks every bucket, so doing it
# on each message would make the cheap path the expensive one — ten thousand
# drivers would mean ten thousand checks per message. Raising this trades memory
# for CPU; lowering it trades back. It does not affect how strict the limit is.
#
# "Eviction" here means the in-memory token buckets and nothing else. Places,
# names and per-driver settings live in the SQLite file and are never touched by
# this; the only thing dropped is a token counter.
THROTTLE_PRUNE_INTERVAL_SECONDS=60
